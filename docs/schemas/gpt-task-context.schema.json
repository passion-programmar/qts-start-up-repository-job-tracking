{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qts-job-tracking.local/schemas/gpt-task-context.json",
  "title": "QTS GPT Application Task Context",
  "description": "Response from GET /api/v2/gpt-application-tasks/{taskId}/context.",
  "type": "object",
  "required": [
    "success",
    "taskId",
    "pageNumber",
    "jobContext",
    "candidate",
    "managerAnswers",
    "resumeText",
    "previousAnswers",
    "previousUnresolvedFields",
    "page"
  ],
  "properties": {
    "success": { "type": "boolean" },
    "taskId": { "type": "string", "pattern": "^task_[0-9a-fA-F-]{36}$" },
    "pageNumber": { "type": "integer" },
    "jobContext": {
      "type": "object",
      "properties": {
        "jobId": { "type": "integer" },
        "jobTitle": { "type": "string" },
        "company": { "type": "string" },
        "jobUrl": { "type": "string", "format": "uri" },
        "platform": { "type": "string" },
        "jobDescription": { "type": "string" }
      },
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "description": "Saved Account profile, education, work history, and Account-specific custom facts.",
      "properties": {
        "customFields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fieldName", "value"],
            "properties": {
              "fieldName": { "type": "string" },
              "value": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "managerAnswers": {
      "type": "object",
      "description": "Manager-saved authorization, salary, and custom answers.",
      "additionalProperties": true
    },
    "resumeText": {
      "type": "string",
      "description": "Text extracted from the saved resume PDF when available."
    },
    "previousAnswers": {
      "type": "array",
      "items": { "$ref": "#/$defs/answer" }
    },
    "previousUnresolvedFields": {
      "type": "array",
      "items": { "$ref": "#/$defs/unresolvedField" }
    },
    "page": { "$ref": "#/$defs/page" }
  },
  "$defs": {
    "answer": {
      "type": "object",
      "required": ["stableFieldId", "answer"],
      "properties": {
        "stableFieldId": { "type": "string" },
        "answer": { "type": "string" }
      }
    },
    "unresolvedField": {
      "type": "object",
      "required": ["stableFieldId", "question", "reason"],
      "properties": {
        "stableFieldId": { "type": "string" },
        "question": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "field": {
      "type": "object",
      "required": ["stableFieldId", "label", "fieldType", "required"],
      "properties": {
        "stableFieldId": { "type": "string" },
        "label": { "type": "string" },
        "fieldType": { "type": "string" },
        "fieldKey": { "type": "string" },
        "documentSlot": { "type": "string", "enum": ["resume", "cover_letter"] },
        "required": { "type": "boolean" },
        "options": { "type": "array", "items": { "type": "string" } },
        "placeholder": { "type": "string" },
        "currentValue": { "type": "string" }
      }
    },
    "page": {
      "type": "object",
      "required": ["pageUrl", "pageTitle", "pageNumber", "fields"],
      "properties": {
        "pageUrl": { "type": "string", "format": "uri" },
        "pageTitle": { "type": "string" },
        "pageNumber": { "type": "integer" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      }
    }
  }
}
